<div class="container alerts" aria-live="polite" aria-atomic="true">
@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="status" data-auto-dismiss="4500">
        <span aria-hidden="true">✓</span>
        <div>@success</div>
        <button type="button" data-dismiss aria-label="Cerrar mensaje">×</button>
        <i class="alert-timer" aria-hidden="true"></i>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-error" role="alert">
        <span aria-hidden="true">!</span>
        <div>@error</div>
        <button type="button" data-dismiss aria-label="Cerrar mensaje">×</button>
    </div>
}
@if (TempData["Info"] is string info)
{
    <div class="alert alert-info" role="status" data-auto-dismiss="6000">
        <span aria-hidden="true">i</span>
        <div>@info</div>
        <button type="button" data-dismiss aria-label="Cerrar mensaje">×</button>
        <i class="alert-timer" aria-hidden="true"></i>
    </div>
}
</div>
