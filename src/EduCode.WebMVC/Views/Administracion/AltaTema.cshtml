@model AltaTemaViewModel
@{ ViewData["Title"] = "Nuevo tema"; 
    ViewData["EduCodeRobotContext"] = "practice";
    ViewData["EduCodeRobotInitialAnimation"] = "idle";}
<section class="page-hero compact"><div class="container"><a class="back-link light-link" asp-action="Index">← Volver a administración</a><span class="eyebrow light">NUEVO MÓDULO</span><h1>Crear tema</h1><p>Definí una unidad conceptual dentro del recorrido del curso.</p></div></section><section class="section"><div class="container form-page-grid"><form asp-action="AltaTema" method="post" class="panel form-card"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid two"><div><label asp-for="Formulario.CursoId">Curso</label><select asp-for="Formulario.CursoId">@foreach(var curso in Model.Cursos){<option value="@curso.Id">@curso.Codigo · @curso.Nombre</option>}</select></div><div><label asp-for="Formulario.Orden">Orden</label><input asp-for="Formulario.Orden" type="number" min="1" /><span asp-validation-for="Formulario.Orden"></span></div></div><label asp-for="Formulario.Nombre">Nombre del tema</label><input asp-for="Formulario.Nombre" placeholder="Ej.: Arrays" /><span asp-validation-for="Formulario.Nombre"></span><label asp-for="Formulario.Descripcion">Descripción didáctica</label><textarea asp-for="Formulario.Descripcion" rows="4" placeholder="Explicá qué conceptos agrupa y qué podrá hacer el alumno."></textarea><span asp-validation-for="Formulario.Descripcion"></span><label asp-for="Formulario.TemaPrerequisitoId">Tema prerequisito <small>(opcional)</small></label><select asp-for="Formulario.TemaPrerequisitoId"><option value="">Sin prerequisito</option>@foreach(var tema in Model.Temas){<option value="@tema.Id">@(tema.Orden). @tema.Nombre</option>}</select><div class="form-actions"><a class="button button-outline" asp-action="Index">Cancelar</a><button class="button" type="submit">Crear tema →</button></div></form><aside class="form-help"><div class="form-robot-card"><partial name="_EduCodeRobot" /></div><span class="eyebrow">BUENAS PRÁCTICAS</span><h2>Un tema debe ser reconocible</h2><ul class="check-list"><li>Usá un concepto concreto como título.</li><li>Describí el resultado de aprendizaje.</li><li>Ubicalo después de sus conocimientos previos.</li><li>Evitá módulos demasiado amplios.</li></ul></aside></div></section>
