@model AltaEjercicioViewModel
@{ ViewData["Title"] = "Nuevo ejercicio"; 
    ViewData["EduCodeRobotContext"] = "practice";
    ViewData["EduCodeRobotInitialAnimation"] = "idle";}
<section class="page-hero compact"><div class="container"><a class="back-link light-link" asp-action="Index">← Volver a administración</a><span class="eyebrow light">NUEVA CONSIGNA</span><h1>Crear ejercicio</h1><p>Definí el problema, la base de código y la rúbrica que utilizará el feedback.</p></div></section><section class="section"><div class="container"><form asp-action="AltaEjercicio" method="post" class="exercise-form"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><section class="panel form-card"><div class="form-section-heading"><span>01</span><div><h2>Información general</h2><p>Ubicación y nivel dentro del recorrido.</p></div></div><div class="form-grid three"><div><label asp-for="TemaId">Tema</label><select asp-for="TemaId">@foreach(var tema in Model.Temas){<option value="@tema.Id">@(tema.Orden). @tema.Nombre</option>}</select></div><div><label asp-for="Dificultad"></label><select asp-for="Dificultad"><option value="1">Inicial</option><option value="2">Básico</option><option value="3">Intermedio</option><option value="4">Avanzado</option><option value="5">Desafío</option></select></div><div><label asp-for="Orden"></label><input asp-for="Orden" type="number" min="1" /></div></div><label asp-for="Titulo"></label><input asp-for="Titulo" placeholder="Ej.: Validar una contraseña" /><span asp-validation-for="Titulo"></span><label asp-for="Consigna"></label><textarea asp-for="Consigna" rows="5" placeholder="Describí entradas, procesamiento esperado y salida sin revelar la implementación."></textarea><span asp-validation-for="Consigna"></span></section><section class="panel form-card"><div class="form-section-heading"><span>02</span><div><h2>Espacio de resolución</h2><p>Plantilla inicial que verá el estudiante.</p></div></div><div class="form-grid three"><div><label asp-for="PuntajeMaximo"></label><input asp-for="PuntajeMaximo" type="number" /></div><div><label asp-for="PuntajeMinimoAprobacion"></label><input asp-for="PuntajeMinimoAprobacion" type="number" /></div><div><label>Lenguaje</label><input value="JavaScript" disabled /></div></div><label asp-for="CodigoInicial">Código inicial</label><textarea asp-for="CodigoInicial" class="code-textarea" rows="10" spellcheck="false"></textarea><span asp-validation-for="CodigoInicial"></span></section><section class="panel form-card"><div class="form-section-heading"><span>03</span><div><h2>Rúbrica y ayuda</h2><p>Criterios concretos para orientar la corrección.</p></div></div><label asp-for="CriterioPrincipal"></label><textarea asp-for="CriterioPrincipal" rows="3" placeholder="Ej.: Recorre todos los caracteres y valida cada condición solicitada."></textarea><span asp-validation-for="CriterioPrincipal"></span><label asp-for="CriterioCalidad"></label><textarea asp-for="CriterioCalidad" rows="2"></textarea><span asp-validation-for="CriterioCalidad"></span><div class="form-grid three"><div><label asp-for="PistaNivel1"></label><textarea asp-for="PistaNivel1" rows="4" placeholder="Recordá el concepto principal sin señalar la línea exacta."></textarea></div><div><label asp-for="PistaNivel2"></label><textarea asp-for="PistaNivel2" rows="4" placeholder="Orientá hacia la estructura o estrategia necesaria."></textarea></div><div><label asp-for="PistaNivel3"></label><textarea asp-for="PistaNivel3" rows="4" placeholder="Indicá qué parte revisar sin entregar la solución."></textarea></div></div></section><section class="panel form-robot-card"><partial name="_EduCodeRobot" /></section><div class="form-actions sticky-actions"><a class="button button-outline" asp-action="Index">Cancelar</a><button class="button button-lg" type="submit">Publicar ejercicio →</button></div></form></div></section>
